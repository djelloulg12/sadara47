rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /coach-applications/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid && request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'president'];
    }
  }
}

