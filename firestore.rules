rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return profile().role; }

    /* The club owner. Named by address in config/owners, so the right follows the
       person rather than a user id that only exists once an account has been
       created -- otherwise the owner would have to wait for an account to exist
       before being able to create one. No user document is needed: the token
       already carries the address.

       config/owners must be readable by every signed-in account. Gating its read
       on ownerEmail() looks tighter but is circular: ownerEmail() reads this
       document, so asking "may I read it?" re-enters the same question and
       Firestore denies the whole thing. The owner would then hold no rights at
       all, silently. The addresses are already known to anyone who can read the
       club's public page, so signed-in is the honest boundary; the write stays
       with the owner, which is the side that matters. */
    function ownerList() {
      return get(/databases/$(database)/documents/config/owners).data.emails;
    }
    function ownerEmail() { return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ownerList(); }

    function manager() { return ownerEmail() || (signedIn() && role() in ['admin', 'president']); }
    function coach() { return signedIn() && role() == 'coach'; }
    function staff() { return manager() || coach(); }

    match /config/owners {
      allow read: if signedIn();
      allow write: if ownerEmail();
    }

    // Accounts: a member reads only their own document; management reads all.
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || manager());
      allow create: if signedIn() && (request.auth.uid == id || ownerEmail());
      allow update: if signedIn() && (request.auth.uid == id || manager());
      allow delete: if manager();
    }

    // Prices are public so the sign-up page can show them.
    match /subscription_plans/{id} {
      allow read: if true;
      allow write: if manager();
    }
    match /fee_settings/{id} {
      allow read: if true;
      allow write: if manager();
    }
    match /coach_requirements/{id} {
      allow read: if true;
      allow write: if manager();
    }
    // Pool and venue names: public so the registration form can offer them,
    // management-only so only the club decides what a swimmer may pick.
    match /facilities/{id} {
      allow read: if true;
      allow write: if manager();
    }

    // Applications: public sign-ups always start pending; coach files belong to the applicant.
    match /applications/{id} {
      allow create: if (request.resource.data.application_type == 'coach')
        ? (signedIn() && request.resource.data.applicant_uid == request.auth.uid
           && request.resource.data.status == 'pending')
        : (request.resource.data.status == 'pending'
           && !('reviewed_by' in request.resource.data));
      allow read: if manager()
        || (signedIn() && resource.data.application_type == 'coach'
            && resource.data.applicant_uid == request.auth.uid);
      allow update: if manager();
      allow delete: if manager();
    }

    // Roster: management and coaches only. A member reads their own card from users/{uid}.
    match /swimmers/{id} {
      allow read: if staff();
      allow write: if manager();
    }

    // Attendance: staff write, everyone signed in can read only their own group totals,
    // so keep reads for management and coaches to avoid leaking other members' days.
    match /attendance/{id} {
      allow read: if staff();
      allow create, update: if staff();
      allow delete: if manager();
    }

    // Cards belong to the member; management and coaches issue them.
    match /cards/{id} {
      allow read: if staff() || (signedIn() && resource.data.member_no == profile().member_no);
      allow write: if manager();
    }

    match /notices/{id} {
      allow read: if true;
      allow write: if manager();
    }
    // the weekly timetable is published on the club's public page
    match /schedules/{id} {
      allow read: if true;
      allow write: if manager();
    }

    // Cash ledger: written when a request is settled, read by management only.
    match /payments/{id} {
      allow read: if manager();
      allow create: if manager();
      allow update, delete: if false;
    }

    // Decision trail, written by the client after a successful API call.
    match /audit_logs/{id} {
      allow read: if manager();
      allow create: if manager();
      allow update, delete: if false;
    }
  }
}