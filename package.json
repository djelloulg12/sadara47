{
  "name": "sadara-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة النادي الرياضي الصدارة — فوج السباحة",
  "scripts": {
    "serve": "python server.py",
    "build": "python tools/build/build-app.py",
    "check": "node tools/verify.js",
    "user": "python tools/create-user.py",
    "preview:form": "node tools/tests/packet-preview.js",
    "doctor": "node tools/check-network.js",
    "login": "powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 login --no-localhost --add-project",
    "whoami": "powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 login:list",
    "projects": "powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 projects:list",
    "deploy": "npm run check && powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 deploy",
    "deploy:rules": "powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 deploy --only firestore:rules,storage",
    "preview": "npm run check && powershell -ExecutionPolicy Bypass -File tools/firebase.ps1 hosting:channel:deploy preview"
  },
  "devDependencies": {
    "firebase-tools": "^15.32.1",
    "jsdom": "^25.0.0"
  }
}
